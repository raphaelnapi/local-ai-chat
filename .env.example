# Versoes verificadas no momento da criacao do projeto.
POSTGRES_VERSION=17.11-alpine
OLLAMA_VERSION=0.33.3
OPEN_WEBUI_VERSION=v0.11.3

POSTGRES_DB=openwebui
POSTGRES_USER=openwebui
# Exemplo local apenas. Troque antes de iniciar.
# Use somente caracteres alfanumericos ou codifique caracteres especiais para URL.
POSTGRES_PASSWORD=troqueEstaSenha123

OPEN_WEBUI_PORT=3000
WEBUI_URL=http://localhost:3000
# Exemplo inseguro. Gere uma chave aleatoria conforme o README.
WEBUI_SECRET_KEY=troque-por-uma-chave-aleatoria-segura

# Chave usada pelo Open WebUI para autenticar no Open Terminal.
OPEN_TERMINAL_API_KEY=troque-por-outra-chave-aleatoria-segura

TZ=America/Sao_Paulo
